# System Meta settings
PROJECT_NAME="Matter AI Spatial Intelligence API"
ENV=development

# Security setup
# Generate a secure key in production using: openssl rand -hex 32
SECRET_KEY=aura_secret_orchestration_development_key_default
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_HOURS=12

# PostgreSQL credentials
POSTGRES_USER=homedecor_user
POSTGRES_PASSWORD=homedecor_password
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=homedecor_db
# DATABASE_URL=postgresql://homedecor_user:homedecor_password@localhost:5432/homedecor_db

# Redis connection URI
REDIS_URL=redis://localhost:6379/0
CELERY_ALWAYS_EAGER=false

# OpenRouter / Vision-Language Model
OPENROUTER_API_KEY=your_openrouter_api_key_here
DINO_API_MODEL=qwen/qwen3-vl-30b-a3b-instruct

# Storage integrations (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Gemini / Imagen Generative Redesign API
# Enter your Google AI Studio API key below:
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
IMAGEN_MODEL=imagen-3.0-generate-002

